        "author_id": "1807910824918634496",
        "conversation_id": "2072865836931678231",
        "created_at": "2026-07-03T02:11:42.000Z",
        "edit_controls": {
          "editable_until": "2026-07-03T03:11:42.000Z",
          "edits_remaining": 5,
